{
  "name": "oyun-pusulasi-desktop",
  "version": "0.3.0",
  "description": "Game Compass / Oyun Pusulasi local Steam game discovery desk",
  "main": "main.js",
  "author": "Game Compass",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.oyunpusulasi.desktop",
    "productName": "Game Compass",
    "artifactName": "Game-Compass-${version}-Setup.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "icon": "assets/oyun-pusulasi-icon.ico",
    "files": [
      "main.js",
      "package.json",
      "assets/oyun-pusulasi-icon.ico"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "icon": "assets/oyun-pusulasi-icon.ico",
      "target": ["nsis"],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Game Compass",
      "uninstallDisplayName": "Game Compass"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
